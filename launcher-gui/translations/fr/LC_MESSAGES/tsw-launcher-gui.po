msgstr "la métrique de fenêtre {0}={1} est invraisemblable (attendu {2}..={3})"

msgid "the prefix was created without the 32-bit FreeType/Fontconfig libraries; install them and create a NEW prefix (`tsw-launch prefix init`)"
msgstr "le préfixe a été créé sans les bibliothèques FreeType/Fontconfig 32 bits ; installez-les et créez un NOUVEAU préfixe (`tsw-launch prefix init`)"

msgid "{0} is not an initialised Wine prefix (no user.reg)"
msgstr "{0} n’est pas un préfixe Wine initialisé (pas de user.reg)"

msgid "run `tsw-launch prefix init --prefix <dir> --runner <wine>`"
msgstr "exécutez `tsw-launch prefix init --prefix <dossier> --runner <wine>`"

msgid "{0} differs from the runtime's copy"
msgstr "{0} diffère de la copie du runtime"

msgid "re-run `tsw-launch prefix init` to refresh the components"
msgstr "relancez `tsw-launch prefix init` pour actualiser les composants"

msgid "{0} is missing"
msgstr "{0} est manquant"

msgid "runtime component {0} unreadable: {1}"
msgstr "composant du runtime {0} illisible : {1}"

