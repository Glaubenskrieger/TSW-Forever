msgstr "wine créera un préfixe vide ; le jeu a besoin des composants habituels (DXVK, d3dx, vcrun) installés dedans"

msgid "no prefix set (wine would use ~/.wine)"
msgstr "aucun préfixe défini (wine utiliserait ~/.wine)"

msgid "pass --prefix or prefix = ... in the config"
msgstr "indiquez --prefix ou prefix = ... dans la configuration"

msgid "a display is available (DISPLAY or WAYLAND_DISPLAY)"
msgstr "un affichage est disponible (DISPLAY ou WAYLAND_DISPLAY)"

msgid "no DISPLAY / WAYLAND_DISPLAY in the environment"
msgstr "ni DISPLAY ni WAYLAND_DISPLAY dans l’environnement"

msgid "start from a graphical session; the client needs a window"
msgstr "lancez depuis une session graphique ; le client a besoin d’une fenêtre"

