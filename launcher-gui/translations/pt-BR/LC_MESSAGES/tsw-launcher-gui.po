msgstr "execute `tsw-launch prefix init` ou inicie o Wine uma vez neste prefixo"

msgid "window metric {0}={1}"
msgstr "métrica de janela {0}={1}"

msgid "window metric {0}={1} is implausible (expected {2}..={3})"
msgstr "a métrica de janela {0}={1} é implausível (esperado {2}..={3})"

msgid "the prefix was created without the 32-bit FreeType/Fontconfig libraries; install them and create a NEW prefix (`tsw-launch prefix init`)"
msgstr "o prefixo foi criado sem as bibliotecas FreeType/Fontconfig de 32 bits; instale-as e crie um prefixo NOVO (`tsw-launch prefix init`)"

msgid "{0} is not an initialised Wine prefix (no user.reg)"
msgstr "{0} não é um prefixo do Wine inicializado (sem user.reg)"

msgid "run `tsw-launch prefix init --prefix <dir> --runner <wine>`"
msgstr "execute `tsw-launch prefix init --prefix <pasta> --runner <wine>`"

msgid "{0} differs from the runtime's copy"
msgstr "{0} difere da cópia do runtime"

msgid "re-run `tsw-launch prefix init` to refresh the components"
msgstr "execute `tsw-launch prefix init` novamente para atualizar os componentes"

msgid "{0} is missing"
msgstr "{0} está ausente"

