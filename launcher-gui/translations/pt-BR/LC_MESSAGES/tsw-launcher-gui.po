msgstr "{0} de 32 bits não encontrado"

msgid "install {0}: {1}"
msgstr "instale {0}: {1}"

msgid "XInput2: without it Wine refuses cursor clipping and a full-screen client spins in a message loop"
msgstr "XInput2: sem ele, o Wine recusa a captura do cursor e um cliente em tela cheia fica preso em um loop de mensagens"

msgid "display mode changes (ChangeDisplaySettings) fail"
msgstr "as mudanças de modo de exibição (ChangeDisplaySettings) falham"

