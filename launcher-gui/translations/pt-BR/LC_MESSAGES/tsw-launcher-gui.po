msgstr "substituição do manifesto rejeitada: {0}"

msgid "only the documented graphics DLLs with mode n/b may be overridden; recreate the prefix with `tsw-launch prefix init`"
msgstr "somente as DLLs gráficas documentadas com o modo n/b podem ser substituídas; recrie o prefixo com `tsw-launch prefix init`"

