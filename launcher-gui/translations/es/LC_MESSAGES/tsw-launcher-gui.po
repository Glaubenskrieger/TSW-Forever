msgstr "Listo."

msgid "Size of the virtual desktop: use the form 1920x1200 (320 to 16384)"
msgstr "Tamaño del escritorio virtual: usa el formato 1920x1200 (de 320 a 16384)"

msgid "The start command could not be run ({0}): {1}"
msgstr "No se pudo ejecutar el comando de inicio ({0}): {1}"

