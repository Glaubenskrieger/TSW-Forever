msgstr "Gotowe."

msgid "Size of the virtual desktop: use the form 1920x1200 (320 to 16384)"
msgstr "Rozmiar wirtualnego pulpitu: użyj formatu 1920x1200 (od 320 do 16384)"

msgid "The start command could not be run ({0}): {1}"
msgstr "Nie udało się wykonać polecenia uruchamiającego ({0}): {1}"

